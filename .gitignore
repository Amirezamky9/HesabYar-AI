# ==============================================================================
# HesabYar-AI .gitignore
# ==============================================================================

# 1. Python & Environment Artifacts
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
.pytest_cache/
.hypothesis/
.ruff_cache/
.coverage
htmlcov/

# 2. Sensitive Data, Certificates & Credentials (CRITICAL for Moadian)
.env
.env.*
!.env.example
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
secrets/
credentials/
*token*
# ...but the admin theme-token stylesheet is source, not a secret:
!apps/admin/styles/tokens.css
# ...and so is the monitoring token-record dialog (US-704):
!apps/admin/features/monitoring/monitoring-token-dialog.tsx
auth.json

# 3. Claude & Agent Scaffolding
CLAUDE.md
claude.md
.claude/
.claude*
.gstack/
.gstack*
.agents/

# 4. Hermes Scaffolding & State
HERMES.md
.hermes/
.hermes*

# 5. Workspace, Scratch & Logs
.scratch/
*.log
logs/*.log
*.tmp
*.bak
*.swp
*.swo

# 6. Operating System & Editor Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# 7. Upstream & Large Source Document Exclusions
standards/*/source/*.doc
standards/*/source/*.pdf
standards/*/source/media/
standards/*/source/*.docx
standards/*/source/s*.doc
scripts/test_*.py

# 8. Tryton module build artifacts (trytond-hesabyar-setup etc.)
tryton-modules/*/build/
tryton-modules/*/dist/
tryton-modules/*/*.egg-info/

# 9. CI script working dirs (scripts/ci/setup-tryton.sh,
#    scripts/ci/setup-playwright.sh defaults — local disposable state)
.tryton-env/
.tryton-data/
.playwright-data/

# 10. Measured performance baselines (US-702): generated by the load
# tests with HESABYAR_RECORD_BASELINES=1; the committed numbers live
# in docs/performance-baselines.md, not in this file.
performance-baselines.json
