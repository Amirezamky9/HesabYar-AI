# Copy to .env.local and fill in (never commit .env.local).
# FastAPI backend base URL (no trailing slash). Default if unset: http://127.0.0.1:8001
HESABYAR_API_BASE_URL=http://127.0.0.1:8001
# Dev operator API key for the Playwright login test. Mint one with:
#   uv run python apps/admin/scripts/mint-dev-key.py
# (from the repo root, with HESABYAR_DATABASE_URL set — see README.md)
HESABYAR_DEV_API_KEY=
